# --- PostgreSQL（docker-compose 建 postgres 服務用）---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=datalens

# --- 應用連線字串（本機非 docker 直連 localhost；docker 由 compose 覆蓋成 postgres/redis 主機名）---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/datalens
REDIS_URL=redis://localhost:6379/0
